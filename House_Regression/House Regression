list -- a list of y training data sets\n","    y_test_list -- a list of y test data sets\n","    \"\"\"\n","    # Create a summary table.\n","    summary_table = pd.DataFrame(\n","        columns=[\n","            'Train Adj Pseudo R2', 'Test Adj Pseudo R2',\n","            'Train Deviance Per Obs', 'Test Deviance Per Obs',\n","            'Train Dispersion Parameter', 'Test Dispersion Parameter'\n","            ]\n","        )\n","\n","    # Iterate through the model list.\n","    for i in range(len(model_list)):\n","        # Acquire the test prediciton values for each model.\n","        predictions = model_list[i].predict(X_famd_df_test_list[i])\n","\n","        # Acquire the training dispersion parameter estimate.\n","        dispersion_train = model_list[i].scale\n","\n","        # Acquire the test dispersion parameter estimate.\n","        pearson_residuals = (y_test_list[i]-predictions)**2 / predictions**3\n","        residual_df = len(y_test_list[i]) - X_famd_df_test_list[i].shape[1]\n","        dispersion_test = np.sum(a=pearson_residuals) / residual_df\n","\n","        # Acqurie the training adjusted pseudo R-squared.\n","        pseudo_r2_train = model_list[i].pseudo_rsquared()\n","        n, p = model_list[i].nobs, len(model_list[i].params) - 1\n","        adjusted_pseudo_r2_train = 1 - (n-1)/(n-p-1)*(1-pseudo_r2_train)\n","\n","        # Acquire the test adjusted pseudo R-squared. First, find log\n","        # likelihood of model.\n","        log_likelihood = model_list[i].family.loglike(\n","            endog=y_test_list[i], mu=predictions, scale=dispersion_train\n","            )\n","\n","        # Next, acqurie the log likelihood of the null function.\n","        X_test_null = sm.add_constant(data=np.ones(shape=len(y_test_list[i])))\n","        glm_null_model = sm.GLM(\n","            endog=y_test_list[i], exog=X_test_null,\n","            family=sm.families.InverseGaussian(\n","                link=sm.families.links.Log()\n","                )\n","            ).fit(cov_type='HC3')\n","        null_predictions = glm_null_model.predict(X_test_null)\n","\n","        log_likelihood_null = model_list[i].family.loglike(\n","            endog=y_test_list[i], mu=null_predictions, scale=dispersion_train\n","            )\n","\n","        # Lastly, calculate the test adjusted pseudo R-squared.\n","        pseudo_r2_test = 1 - (\n","            np.exp((log_likelihood_null-log_likelihood)*2/len(y_test_list[i]))\n","            )\n","        n, p = len(y_test_list[i]), X_famd_df_test_list[i].shape[1] - 1\n","        adjusted_pseudo_r2_test = 1 - (n-1)/(n-p-1)*(1-pseudo_r2_test)\n","\n","        # Acqurie the training deviance per observation.\n","        deviance_train = model_list[i].deviance / len(y_train_list[i])\n","\n","        # Acqurie the test deviance per observation.\n","        deviance_test = (\n","            np.sum(\n","                a=(y_test_list[i]-predictions)**2\n","                /(y_test_list[i]*predictions**2)\n","                )\n","            / len(y_test_list[i])\n","            )\n","\n","        # Make the values into a new row and add it to the summary\n","        # table.\n","        new_row_data = [\n","            adjusted_pseudo_r2_train, adjusted_pseudo_r2_test, deviance_train,\n","            deviance_test, dispersion_train, dispersion_test\n","            ]\n","        summary_table.loc[len(summary_table)] = new_row_data\n","\n","    # Convert the index into a column for the fold number.\n","    summary_table.index.name = INDEX_NAME\n","    summary_table.index += 1\n","\n","    # Display the final table.\n","    display(summary_table)"],"metadata":{"id":"16ZYtV_Rew99","executionInfo":{"status":"ok","timestamp":1767744379575,"user_tz":360,"elapsed":1,"user":{"displayName":"Sean Graham","userId":"14400275736943667243"}}},"execution_count":22,"outputs":[]},{"cell_type":"markdown","source":["The final two cells call the summary_table function on the original and reduced data. It should be noted that for each pair of training and test metrics, the values are only problematic if the difference or proportion (depending on the metric) is relatively large."],"metadata":{"id":"nPXn2cpWafd_"}},{"cell_type":"code","source":["summary_table(\n","    model_list=model_list_original,\n","    X_famd_df_train_list=X_famd_df_train_list_original,\n","    X_famd_df_test_list=X_famd_df_test_list_original,\n","    y_train_list=y_train_list_original, y_test_list=y_test_list_original\n","    )"],"metadata":{"id":"gvyh8YG6UvG7","executionInfo":{"status":"ok","timestamp":1767744379581,"user_tz":360,"elapsed":5,"user":{"displayName":"Sean Graham","userId":"14400275736943667243"}},"colab":{"base_uri":"https://localhost:8080/","height":252},"outputId":"2fe2cc19-77dc-4608-83a6-62d1b42f0d7c"},"execution_count":23,"outputs":[{"output_type":"display_data","data":{"text/plain":["      Train Adj Pseudo R2  Test Adj Pseudo R2  Train Deviance Per Obs  \\\n","Fold                                                                    \n","1                0.864570            0.804589                0.010620   \n","2                0.869924            0.832456                0.010182   \n","3                0.862582            0.890560                0.009883   \n","4                0.852390            0.814273                0.010645   \n","5                0.866769            0.838684                0.010441   \n","\n","      Test Deviance Per Obs  Train Dispersion Parameter  \\\n","Fold                                                      \n","1                  0.009832                    0.010460   \n","2                  0.011179                    0.010172   \n","3                  0.012868                    0.009923   \n","4                  0.010608                    0.010689   \n","5                  0.011567                    0.010091   \n","\n","      Test Dispersion Parameter  \n","Fold                             \n","1                      0.011796  \n","2              